# NOVARUM Commerce Engine - Local Environment Config
# Gate 2-A1 Local Testing Configuration (NON-PRODUCTION)

# Server Config
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Multi-tenant Configuration (Authoritative Backend-Injected Tenant)
DEFAULT_ACADEMY_ID=dr-sevilla

# Security & CORS
ALLOWED_ORIGINS=https://pedrosevilla.novaforge.group,http://127.0.0.1:3000,http://localhost:3000
IDEMPOTENCY_SECRET_SALT=novarum_local_idempotency_salt_2026

# PostgreSQL Connection (Local / In-memory test)
# For local Docker: postgresql://postgres:postgres@localhost:5432/novarum_b2c_commerce
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novarum_b2c_commerce
